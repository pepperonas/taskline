{
  "name": "taskline",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code mod: live progress of long-running jobs above the prompt",
  "type": "module",
  "license": "MIT",
  "author": "Martin Pfeffer <martin.pfeffer@celox.io> (https://celox.io)",
  "repository": "github:pepperonas/taskline",
